# Railway Ticket Reservation and Journey Management System Configuration
# Copy this file to .env and customize as needed.

# Flask Application Settings
SECRET_KEY=railway-dbms-secret-key-2026-production
FLASK_ENV=development
PORT=5001

# Primary Database Target: MySQL 8.x InnoDB
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/railway_db

# SQLite Local Fallback Mode (Uncomment below to use local SQLite file instead):
# DATABASE_URL=sqlite:///railway.db

# SQL Logging (Set to True to print raw SQL queries to console)
SQLALCHEMY_ECHO=False
